    "ScanIntervalMs": 1500,
    "PaperTrading": true,
    "Exchanges": [
      "Binance",
      "Bybit",
      "OKX"
    ],
    "EstimatedTakerFees": {
      "Binance": 0.1,
      "Bybit": 0.1,
      "OKX": 0.1,
      "Bitget": 0.1,
      "GateIo": 0.1
    },
    "QuoteSize": 500,
    "MaxDepthLevels": 20
  },
  "AllowedHosts": "*"
