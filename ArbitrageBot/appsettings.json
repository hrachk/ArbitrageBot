{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Arbitrage": {
    "StrategyMode": "FuturesCross",
    "PaperTrading": true,
    "PaperAutoExecute": true,
    "Symbols": [
      "SOLUSDT",
      "XRPUSDT",
      "DOGEUSDT",
      "SUIUSDT",
      "NEARUSDT",
      "ARBUSDT",
      "WIFUSDT",
      "LINKUSDT",
      "AVAXUSDT",
      "INJUSDT",
      "TIAUSDT",
      "ENAUSDT",
      "JUPUSDT",
      "OPUSDT",
      "APTUSDT"
    ],
    "Exchanges": [
      "Binance",
      "Bybit",
      "OKX",
      "Bitget",
      "GateIo"
    ],
    "MinProfitPercent": 0.03,
    "QuoteSize": 200,
    "ScanIntervalMs": 1200,
    "MaxDepthLevels": 30,
    "PaperRequireFullFill": false,
    "PaperCooldownMs": 6000,
    "PaperStartingQuote": 10000,
    "EstimatedTakerFees": {
      "Binance": 0.05,
      "Bybit": 0.055,
      "OKX": 0.05,
      "Bitget": 0.06,
      "GateIo": 0.05
    },
    "DynamicSymbols": true,
    "DynamicTopN": 12,
    "DynamicMinQuoteVolumeUsd": 8000000,
    "DynamicMaxQuoteVolumeUsd": 400000000,
    "DynamicQuoteAsset": "USDT",
    "DynamicRefreshMinutes": 20,
    "ExcludeMajorBases": [
      "BTC",
      "ETH",
      "BNB"
    ],
    "FuturesPaperLeverage": 5,
    "FuturesMaxOpenPositions": 4,
    "FuturesMaxHoldMinutes": 15,
    "FuturesCloseBelowNetPercent": 0.02,
    "FuturesIncludeFunding": true,
    "FuturesFundingPeriods": 1,
    "FuturesRequireRoundTripEdge": false,
    "FuturesMaxMarginUsagePercent": 0.15,
    "FuturesStopLossUsd": -25,
    "FuturesDailyLossLimitUsd": -80,
    "FuturesMaxNotionalUsd": 1200
  },
  "AllowedHosts": "*"
}
