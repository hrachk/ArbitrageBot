@inherits LayoutComponentBase
@inject ArbitrageState State

<div class="shell">
  <aside class="sidebar">
    <div class="brand">
      <span class="brand-mark">◆</span>
      <div>
        <div class="brand-title">ArbitrageBot</div>
        <div class="brand-sub">Futures Cross · Terminal</div>
      </div>
    </div>
    <nav class="nav">
      <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Dashboard</NavLink>
      <NavLink class="nav-link" href="market">Market</NavLink>
      <NavLink class="nav-link" href="reports">Reports</NavLink>
      <NavLink class="nav-link" href="settings">Settings</NavLink>
      <NavLink class="nav-link" href="live">Live Control</NavLink>
    </nav>
    <div class="sidebar-foot">
      <div class="pill @ModeClass">@State.Mode</div>
      <div class="muted tiny">@DateTime.UtcNow.ToString("HH:mm:ss") UTC</div>
    </div>
  </aside>
  <main class="main">
    <header class="topbar">
      <div class="topbar-left">
        <span class="muted">Realtime</span>
        <span class="dot @(State.IsPaused ? "off" : "on")"></span>
        <span>@(State.IsPaused ? "PAUSED" : "RUNNING")</span>
      </div>
      <div class="topbar-actions">
        <button class="btn sm" @onclick="TogglePause">@(State.IsPaused ? "Resume" : "Pause")</button>
      </div>
    </header>
    <div class="content">
      @Body
    </div>
  </main>
</div>

@code {
    string ModeClass => State.Mode?.Contains("LIVE", StringComparison.OrdinalIgnoreCase) == true ? "warn" : "ok";

    void TogglePause()
    {
        State.IsPaused = !State.IsPaused;
    }
}
