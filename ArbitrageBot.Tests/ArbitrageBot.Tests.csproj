<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dependency-free runner for pure trading math. Run: dotnet run project ArbitrageBot.Tests. Non-zero exit on failure. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>ArbitrageBot.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../ArbitrageBot/Services/ArbEconomics.cs" Link="Linked/ArbEconomics.cs" />
    <Compile Include="../ArbitrageBot/Services/TradingMath.cs" Link="Linked/TradingMath.cs" />
  </ItemGroup>

</Project>
