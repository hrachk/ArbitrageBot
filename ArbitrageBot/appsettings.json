    "LiveTradingEnabled": false,
    "LiveReadOnlyMode": true,
    "LiveMaxOpenPositions": 3,
    "LiveMaxNotionalUsd": 100,
    "LiveDailyLossLimitUsd": -40,
    "LiveStopLossUsd": -25,
    "LiveEnableConfirmPhrase": "ENABLE LIVE TRADING",
